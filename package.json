{
  "name": "assure",
  "version": "1.0.0",
  "private": true,
  "description": "A fast Discord economy and game bot powered by Supabase.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@discordjs/ws": "1.2.3",
    "@supabase/supabase-js": "^2.117.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.2.3",
    "redis": "^5.12.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
